APP_NAME=SmartStock AI
ENVIRONMENT=development
DEBUG=True

# --- Database (added in Phase 2) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=smartstock_ai

# --- Authentication (added in Phase 3) ---
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_generated_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI (added in Phase 10) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Market data / Broker (added in Phase 5 / Phase 14) ---
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# --- Broker connection (added in Phase 14) ---
APP_BASE_URL=http://127.0.0.1:8000
# Generate your own with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_ENCRYPTION_KEY=replace_with_a_generated_fernet_key
